{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/build-service-worker.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test components/workspace/*.test.mjs lib/*.test.mjs",
    "test:e2e": "playwright test",
    "test:devtools": "playwright test --config=playwright.dev.config.mjs",
    "db:generate": "drizzle-kit generate --config=server/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=server/db/drizzle.config.ts",
    "db:check": "node --conditions=react-server --import tsx server/db/check.ts",
    "db:prune": "node --conditions=react-server --import tsx scripts/prune-operations.ts",
    "test:server": "node --conditions=react-server --import tsx --test server/tests/*.test.ts",
    "test:server:integration": "node --conditions=react-server --import tsx --test --test-concurrency=1 server/tests/*.integration.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test:online": "playwright test --config=playwright.online.config.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3",
    "@neondatabase/auth": "^0.5.0-beta",
    "dexie": "^4.4.6",
    "drizzle-orm": "^0.45.3",
    "feather-icons": "^4.29.2",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
