# Server-only. Copy to .env.local or use `neon env pull` on your dev branch.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR-ENDPOINT.neonauth.YOUR-REGION.aws.neon.tech/neondb/auth
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
NEON_AUTH_COOKIE_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Required by destructive-fixture integration/browser tests; must be a non-production branch.
NEON_BRANCH=development
